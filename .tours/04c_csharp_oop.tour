{
  "title": "04c: OOP Basics",
  "ref": "main", 
  "steps": [
    {
      "file": "03_MvcCalculator/Models/CalculatorResultViewModel.cs",
      "line": 5,
      "selection": {
        "start": {
          "line": 5,
