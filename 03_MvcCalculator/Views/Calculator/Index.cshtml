@{
    ViewData["Title"] = "Calculator Form";
}

<div class="container mt-5">
    <h2>Calculate（Step 3）</h2>
    <div class="d-flex mb-3">
        <div class="me-3">
            <a href="/Calculator/Tashizan" class="btn btn-primary">足し算</a>
        </div>
        @* TODO: ここに引き算確認用リンク（aタグ）を追加してください（ヒント: 足し算ボタンを参考にしてください） *@
    </div>
    <h2>Calculator Form（Step 4）</h2>
    <p>フォームに入力した数値を送信し、コントローラーで計算します。</p>

    <form action="/Calculator/Calculate" method="post" class="col-md-6">
        <div class="mb-3">
            <label for="a" class="form-label">数値 A</label>
            <input type="number" name="a" id="a" class="form-control" value="10" required />
        </div>
        <div class="mb-3">
            <label for="b" class="form-label">数値 B</label>
            <input type="number" name="b" id="b" class="form-control" value="5" required />
        </div>
        <button type="submit" class="btn btn-primary">計算する</button>
    </form>
</div>
