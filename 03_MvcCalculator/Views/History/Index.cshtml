@model IEnumerable<_03_MvcCalculator.Models.CalculationHistory>
@{
    ViewData["Title"] = "計算履歴（Step 8）";
}

<div class="container mt-5">
    <h2>計算履歴（Step 8: EF Core × SQLite データ永続化）</h2>
    <p class="text-muted">データベース (SQLite) に保存された過去の計算履歴を非同期 (EF Core) で取得して表示します。</p>

    <!-- 簡易追加フォーム（動作テスト用） -->
    <form asp-controller="History" asp-action="Create" method="post" class="row g-3 align-items-center mb-4">
        <div class="col-auto">
            <input type="text" name="expression" class="form-control" placeholder="計算式 (例: 10 + 20)" required />
        </div>
        <div class="col-auto">
            <input type="number" step="any" name="result" class="form-control" placeholder="結果 (例: 30)" required />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">履歴を手動追加</button>
        </div>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>履歴一覧</h4>
        <!-- ハンズオン課題用: 全件削除ボタン -->
        <form asp-controller="History" asp-action="DeleteAll" method="post">
            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('本当にすべての履歴を削除しますか？');">
                全履歴を削除（ハンズオン課題）
            </button>
        </form>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            保存された計算履歴はまだありません。上のフォームから追加してみてください。
        </div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>計算式</th>
                    <th>結果</th>
                    <th>日時</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Expression</td>
                        <td>@item.Result</td>
                        <td>@item.CreatedAt.ToString("yyyy/MM/dd HH:mm:ss")</td>
                        <td>
                            <form asp-controller="History" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm">削除</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
